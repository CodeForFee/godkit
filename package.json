{
  "name": "@codeforfee/godkit",
  "version": "1.1.0",
  "description": "One shared harness for every AI agent. Any agent entering your repo reads the same board, map and thread — so nothing is redone and nobody edits the same file twice.",
  "keywords": [
    "godkit",
    "agent",
    "agents",
    "skills",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "handoff",
    "orchestration",
    "agent-memory"
  ],
  "license": "MIT",
  "author": {
    "name": "CodeForFee",
    "email": "dienhoanguyen11@gmail.com",
    "url": "https://github.com/CodeForFee"
  },
  "homepage": "https://github.com/CodeForFee/godkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeForFee/godkit.git"
  },
  "bugs": {
    "url": "https://github.com/CodeForFee/godkit/issues"
  },
  "type": "commonjs",
  "bin": {
    "godkit": "bin/godkit.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "agents/",
    "hooks/",
    "templates/",
    "commands/",
    "evals/",
    "scripts/uninstall.js",
    "scripts/install.ps1",
    "scripts/install.sh",
    "scripts/runtime-lock.json",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/sync-rules.js --check && node scripts/sync-hooks.js --check && node scripts/sync-templates.js --check && node scripts/check-versions.js",
    "pretest": "npm run check",
    "typecheck": "node scripts/check-types.js",
    "benchmark": "node scripts/benchmark.js",
    "test:artifact": "node --test tests/release-artifact.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
