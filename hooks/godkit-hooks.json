{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brief.js\"",
            "timeout": 10,
            "statusMessage": "Reading .agent/ handoff"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lazy-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading godkit-lazy mode"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/clockout.js\"",
            "timeout": 10,
            "statusMessage": "Checking handoff log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/map-watch.js\"",
            "timeout": 10,
            "statusMessage": "Checking map freshness"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lazy-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading godkit-lazy mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lazy-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking godkit-lazy mode"
          }
        ]
      }
    ]
  }
}
